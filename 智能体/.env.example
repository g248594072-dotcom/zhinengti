# 复制本文件为 .env 并填写 MYSQL_PASSWORD（勿提交 .env 到 Git）
# 直接运行 Python 且 MySQL 也在宿主机时可用 127.0.0.1。
# 网页在 Docker 容器里时：同机不等于同容器，请改成可访问的 MySQL 容器服务名或宿主机地址。
# 连接诊断见 deploy/mysql-connection.md；不要将真实账号密码提交到 Git。

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=customer_ai
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=customer_ai
MYSQL_CHARSET=utf8mb4

# 飞书群机器人 Webhook（每日成交学习完成后推送日报，可选）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_token_here

# SaleSmartly API（可选；也可使用 智能体/api-key.json）
# SALESMARTLY_API_KEY=
# SALESMARTLY_PROJECT_ID=
# SALESMARTLY_BASE_URL=https://developer.salesmartly.com
